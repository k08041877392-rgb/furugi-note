---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
---

<Layout title="プロフィール（運営者情報）" type="WebSite">
  <article>
    <h1 style="margin-bottom: 2rem; border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
      プロフィール（運営者情報）
    </h1>

    <div style="background-color: var(--color-box-bg); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; margin-bottom: 2rem;">
      <h2 style="margin: 0 0 0.5rem 0; font-size: 1.5rem;">{SITE.author.name}</h2>
      <p style="color: var(--color-text-muted); font-size: 1rem; margin: 0 0 1.5rem 0;">{SITE.author.jobTitle}</p>
      <p style="font-size: 1.1rem; line-height: 1.8; margin: 0;">{SITE.author.description}</p>
    </div>

    <div class="article-content">
      <h2>『古着ノオト』について</h2>
      <p>
        当サイト『古着ノオト』は、アメリカ古着・ヴィンテージの目利きとeBay輸出の実践情報をまとめたサイトです。
        海外バイヤーとのやり取りで得られたリアルな相場感や、初心者でも失敗を避けてスムーズに販売を進めるための知見を共有しています。
      </p>
    </div>
  </article>
</Layout>
