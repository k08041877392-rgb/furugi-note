---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  type?: 'WebSite' | 'Article' | 'AboutPage';
  article?: {
    title: string;
    description: string;
    pubDate: Date;
    slug: string;
  };
}

const { title = SITE.title, description = SITE.description, type = 'WebSite', article } = Astro.props;
const pageTitle = title === SITE.title ? SITE.title : `${title} | ${SITE.title}`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <JsonLd type={type} article={article} />
    <style is:global>
      :root {
        --color-bg: #fdfdfd;
        --color-text: #333333;
        --color-text-muted: #666666;
        --color-primary: #2b6cb0;
        --color-border: #e2e8f0;
        --color-box-bg: #f7fafc;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }
      a {
        color: var(--color-primary);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      .site-header {
        border-bottom: 1px solid var(--color-border);
        padding: 1rem 2rem;
        background-color: #ffffff;
      }
      .site-header__container {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
      }
      .site-title {
        font-size: 1.5rem;
        font-weight: bold;
      }
      .site-nav ul {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
      }
      .main-container {
        max-width: 800px;
        margin: 2rem auto;
        padding: 0 1.5rem;
      }
      .site-footer {
        border-top: 1px solid var(--color-border);
        padding: 2rem;
        margin-top: 4rem;
        background-color: var(--color-box-bg);
        text-align: center;
      }
      .footer-links {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 1rem;
      }
      .copyright {
        color: var(--color-text-muted);
        font-size: 0.875rem;
      }
      .author-box {
        background-color: var(--color-box-bg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
        margin: 2rem 0;
      }
      .author-box__header {
        margin-bottom: 0.5rem;
      }
      .author-box__name {
        font-size: 1.25rem;
        font-weight: bold;
      }
      .author-box__title {
        font-size: 0.9rem;
        color: var(--color-text-muted);
      }
      .author-box__bio {
        margin: 0.5rem 0;
        font-size: 0.95rem;
      }
      .author-box__link {
        margin-top: 1rem;
        font-size: 0.9rem;
      }
      /* 記事一覧スタイル */
      .post-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .post-card {
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
        background: #ffffff;
      }
      .post-card__meta {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        margin-bottom: 0.5rem;
      }
      .post-card__title {
        font-size: 1.3rem;
        margin: 0 0 0.5rem 0;
      }
      .post-card__description {
        margin: 0;
        color: var(--color-text-muted);
      }
      /* 記事本文スタイル */
      .article-title {
        font-size: 2rem;
        margin-bottom: 0.5rem;
      }
      .article-meta {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
      }
      .article-content h2 {
        margin-top: 2.5rem;
        border-bottom: 2px solid var(--color-primary);
        padding-bottom: 0.5rem;
      }
      .article-content h3 {
        margin-top: 1.8rem;
      }
      .article-content p {
        margin-bottom: 1.2rem;
      }
      .article-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
      }
      .article-content th, .article-content td {
        border: 1px solid var(--color-border);
        padding: 0.75rem;
        text-align: left;
      }
      .article-content th {
        background-color: var(--color-box-bg);
      }
      @media (max-width: 600px) {
        .site-header__container {
          flex-direction: column;
          gap: 1rem;
        }
        .site-nav ul {
          flex-wrap: wrap;
          justify-content: center;
        }
        .article-title {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="main-container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
